# ─── Shopify (MAISON headless storefront) ─────────────────────────────
# The .myshopify.com domain (NOT the admin.shopify.com URL).
#   VITE_SHOPIFY_DOMAIN=origincodehub.myshopify.com
#
# Admin API token (starts with shpat_) — currently in use.
# Needs the read_products scope enabled in the app, then reinstall.
#   VITE_SHOPIFY_ADMIN_TOKEN=shpat_...
#
# Storefront API token (starts with shpss_) — for future swap.
# Create one at: Admin → Settings → Apps and sales channels → Develop apps
#   VITE_SHOPIFY_STOREFRONT_TOKEN=shpss_...
#
# ISO 4217 currency code that the Shopify store prices in.
#   VITE_SHOP_CURRENCY=CAD
# BCP-47 locale for formatting (en-CA for Canadian English, etc.)
#   VITE_SHOP_LOCALE=en-CA
